[Unit]
Description=Vanliessum.io VPS update (ls-remote, build, health, rollback)
Documentation=file:///opt/vanliessum/deploy/README.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/vanliessum
ExecStart=/opt/vanliessum/deploy/update.sh
TimeoutStartSec=15min
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vanliessum-update

[Install]
WantedBy=multi-user.target
